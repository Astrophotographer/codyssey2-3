# Copy to .env and fill in keys you use.

HOST=0.0.0.0
PORT=8781
DEFAULT_PROVIDER=openai
LOCAL_DEMO_MODE=0

AUTH_USER=change-me
AUTH_PASS=change-me
SESSION_SECRET=change-me-in-production

# --- Local (기존 GPU 워커 또는 데모) ---
# LOCAL_WORKER_URL=http://127.0.0.1:9000
# LOCAL_WORKER_TOKEN=

# --- Fal (추천 · 기존 Qwen-Image-Edit과 동일 계열) ---
# https://fal.ai/dashboard/keys
FAL_KEY=
FAL_PERSON_MODEL=fal-ai/qwen-image-edit-2511
FAL_LANDSCAPE_MODEL=fal-ai/qwen-image-edit-2509

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1
