# Copy to .env for local `vercel dev` / testing.
# Never commit real keys. Set the same names in the Vercel project dashboard.

DEFAULT_PROVIDER=local
MAX_UPLOAD_MB=12

# Optional local GPU worker (otherwise Local uses a free demo PIL filter)
# LOCAL_WORKER_URL=http://127.0.0.1:9000
# LOCAL_WORKER_TOKEN=

# Fal — https://fal.ai/dashboard/keys
FAL_KEY=
FAL_PERSON_MODEL=fal-ai/qwen-image-edit-2511
FAL_LANDSCAPE_MODEL=fal-ai/qwen-image-edit-2509

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1
